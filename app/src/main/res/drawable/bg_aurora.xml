<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep warm charcoal base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14100D"
                android:centerColor="#0A0706"
                android:endColor="#070504"
                android:type="linear" />
        </shape>
    </item>

    <!-- Ember blob, top-left (muted for phone GPUs) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.12"
                android:centerY="0.02"
                android:gradientRadius="440dp"
                android:startColor="#33FF6A3D"
                android:centerColor="#14FF6A3D"
                android:endColor="#00FF6A3D" />
        </shape>
    </item>

    <!-- Coral blob, upper-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.95"
                android:centerY="0.16"
                android:gradientRadius="480dp"
                android:startColor="#2AE5484D"
                android:centerColor="#12E5484D"
                android:endColor="#00E5484D" />
        </shape>
    </item>

    <!-- Amber haze, lower-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.88"
                android:centerY="0.72"
                android:gradientRadius="360dp"
                android:startColor="#18FFB25E"
                android:centerColor="#08FFB25E"
                android:endColor="#00FFB25E" />
        </shape>
    </item>

    <!-- Wine glow, bottom-center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.42"
                android:centerY="1.05"
                android:gradientRadius="580dp"
                android:startColor="#247A2E4D"
                android:centerColor="#0E7A2E4D"
                android:endColor="#007A2E4D" />
        </shape>
    </item>
</layer-list>
