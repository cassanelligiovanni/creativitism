<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Full circle drawn as a single arc back to a point 0.01 short of the start
         (a lone SVG/vector arc command cannot close a true 360-degree loop). Stroke-only
         so it reads as a ring; fillColor stays fully transparent white so runtime tint
         only recolors the stroke. -->
    <path
        android:fillColor="#00FFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M12,2 A10,10 0 1,1 11.99,2 Z" />
</vector>
