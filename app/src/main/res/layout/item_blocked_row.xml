<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_glass_row"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/itemIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/app_icon_description"
            tools:src="@android:drawable/sym_def_app_icon" />

        <TextView
            android:id="@+id/itemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="@color/cv_text"
            android:textSize="15sp"
            tools:text="instagram.com" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/remove_item"
            app:icon="@drawable/ic_remove"
            app:iconTint="@color/cv_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segmented"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/enforcementStrict"
                style="@style/SegmentOption"
                android:text="@string/enforcement_strict" />

            <TextView
                android:id="@+id/enforcementOnce"
                style="@style/SegmentOption"
                android:text="@string/enforcement_once" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/confession_toggle"
            android:textColor="@color/cv_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/confessionSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:thumbTint="@color/switch_thumb"
            app:trackTint="@color/switch_track" />
    </LinearLayout>

</LinearLayout>
