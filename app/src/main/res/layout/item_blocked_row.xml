<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/itemIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/app_icon_description"
            tools:src="@android:drawable/sym_def_app_icon" />

        <TextView
            android:id="@+id/itemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="@color/cv_text"
            android:textSize="16sp"
            tools:text="instagram.com" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/remove_item"
            app:icon="@drawable/ic_remove"
            app:iconTint="@color/cv_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/enforcementToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/enforcementStrict"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="@font/inter"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:text="@string/enforcement_strict"
                android:textAllCaps="false"
                android:textColor="@color/cv_text_secondary"
                android:textSize="12sp"
                app:strokeColor="@color/cv_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/enforcementOnce"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="@font/inter"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:text="@string/enforcement_once"
                android:textAllCaps="false"
                android:textColor="@color/cv_text_secondary"
                android:textSize="12sp"
                app:strokeColor="@color/cv_border" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/confession_toggle"
            android:textColor="@color/cv_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/confessionSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:thumbTint="@color/cv_escape"
            app:trackTint="@color/cv_border" />
    </LinearLayout>

</LinearLayout>
