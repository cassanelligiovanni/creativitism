<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_glass_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/app_icon_description"
        tools:src="@android:drawable/sym_def_app_icon" />

    <TextView
        android:id="@+id/appName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:maxLines="1"
        android:textColor="@color/cv_text"
        android:textSize="15sp"
        tools:text="Example App" />

    <ImageView
        android:id="@+id/toggleIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/color_apps_toggle_description"
        android:padding="6dp"
        app:tint="@color/cv_creative"
        tools:src="@drawable/ic_check_circle" />

</LinearLayout>
