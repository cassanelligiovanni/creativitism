    <string name="grayscale_setup_button">Set up grayscale (one-time)</string>
    <string name="grayscale_setup_title">One-time setup with a computer</string>
    <string name="grayscale_setup_message">Turning the whole screen gray uses a system setting Android only unlocks over ADB — once, from a computer.\n\n1. Enable Developer options and USB debugging on this phone\n2. Plug into a computer with ADB installed\n3. Run:\n\nadb shell pm grant com.creativitism.appredirector android.permission.WRITE_SECURE_SETTINGS\n\nThe grant survives restarts and app updates. Creativitism uses it only to toggle Android\'s own color-correction setting.</string>
    <string name="grayscale_setup_copy">Copy command</string>
    <string name="grayscale_setup_copied">Command copied</string>
    <string name="grayscale_setup_command" translatable="false">adb shell pm grant com.creativitism.appredirector android.permission.WRITE_SECURE_SETTINGS</string>
