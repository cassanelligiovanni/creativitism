<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Raycast dark theme (Material 3) -->
    <style name="Base.Theme.Creativitism" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cv_escape</item>
        <item name="colorOnPrimary">@color/cv_bg</item>
        <item name="colorPrimaryContainer">@color/cv_card</item>
        <item name="colorOnPrimaryContainer">@color/cv_text</item>
        <item name="colorSecondary">@color/cv_creative</item>
        <item name="colorOnSecondary">@color/cv_bg</item>
        <item name="colorError">@color/cv_error</item>
        <item name="colorOnError">@color/cv_on_error</item>
        <item name="android:colorBackground">@color/cv_bg</item>
        <item name="colorOnBackground">@color/cv_text</item>
        <item name="colorSurface">@color/cv_surface</item>
        <item name="colorOnSurface">@color/cv_text</item>
        <item name="colorOnSurfaceVariant">@color/cv_text_secondary</item>
        <item name="colorOutline">@color/cv_border</item>
        <item name="android:statusBarColor">@color/cv_bg</item>
        <item name="android:navigationBarColor">@color/cv_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.Creativitism" parent="Base.Theme.Creativitism" />

    <!-- "Take a breath" sheet: translucent activity, frost drawn by the layout -->
    <style name="Theme.Creativitism.Interstitial">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Fire alarm: fully opaque so the blocked app can never peek through. The
         background color itself is driven by AlarmActivity's pulse animator. -->
    <style name="Theme.Creativitism.Alarm" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/cv_alarm_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/cv_alarm_bg</item>
        <item name="android:navigationBarColor">@color/cv_alarm_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Theme for the transparent proxy activity -->
    <style name="Theme.Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
